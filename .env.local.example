# TalentHub — variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore — no lo subas al repo.
#
# Las variables se irán llenando en cada fase. Por ahora (Fase 1) no hay
# variables requeridas — el sandbox y el placeholder corren sin nada.

# ─── Fase 3 (backend, auth, storage) ──────────────────────────
# DATABASE_URL=
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ─── Fase 4 (IA) ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# ─── Fase 5 (analytics, error tracking) ───────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
